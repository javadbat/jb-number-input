    "./react": {
      "types": "./react/dist/JBNumberInput.d.ts",
      "default": "./react/index.js"
    },
    "./*": "./*"
  },
  "customElements": "web-component/custom-elements.json",
  "repository": {
		"type": "git",
		"url": "git@github.com:javadbat/jb-number-input.git"
  },
  "dependencies": {
    "jb-icons": "^2.3.0",
    "jb-input": "^3.18.0",
    "jb-validation":"^1.0.0",
    "jb-core":"^0.34.0"
  }
}
